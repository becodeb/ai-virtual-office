# Local development. Copy to .env and adjust.

# Host port the office is published on locally.
OFFICE_PORT=8787

# "true" strips every task and prompt summary from the character labels,
# leaving tool names and metadata. Worth turning on before putting this on a
# monitor other people can see.
OFFICE_REDACT_PROMPTS=false

# Populate the office with a synthetic cast so you can see it working
# before installing any hook. Set to false once real sessions are arriving.
OFFICE_DEMO=true
