{
  "name": "ai-virtual-office",
  "private": true,
  "version": "0.0.0",
  "description": "AI Virtual Office — a browser diorama of Claude Code sessions as office workers.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "assets:build": "pnpm --filter assets-pipeline run build:assets",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty",
    "dev:server": "pnpm --filter server dev",
    "dev:client": "pnpm --filter client dev"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
